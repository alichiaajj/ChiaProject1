<?xml version="1.0" encoding="utf-8"?>
<shape
    xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Resource solid untuk tampilan aplikasi. -->
    <solid
        android:color="#ECF6F4" />
    <!-- Resource corners untuk tampilan aplikasi. -->
    <corners
        android:radius="22dp" />
    <!-- Resource stroke untuk tampilan aplikasi. -->
    <stroke
        android:width="1dp"
        android:color="#ECF6F4" />
    <!-- Resource padding untuk tampilan aplikasi. -->
    <padding
        android:left="14dp"
        android:right="14dp"
        android:top="12dp"
        android:bottom="12dp" />
</shape>

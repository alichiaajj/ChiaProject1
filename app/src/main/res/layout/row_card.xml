<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp">
    <!-- Menampilkan gambar atau ikon dari drawable. -->
    <ImageView
        android:id="@+id/card_image"
        android:layout_width="match_parent"
        android:layout_height="138dp"
        android:scaleType="centerCrop"
        android:src="@drawable/community_hero"
        android:contentDescription="Ilustrasi kegiatan komunitas" />
    <!-- Menampilkan teks pada halaman. -->
    <TextView
        android:id="@+id/card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/dark"
        android:textSize="16sp"
        android:textStyle="bold" />
    <!-- Menampilkan teks pada halaman. -->
    <TextView
        android:id="@+id/card_meta"
        style="@style/Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp" />
    <!-- Menampilkan teks pada halaman. -->
    <TextView
        android:id="@+id/card_body"
        style="@style/Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />
    <!-- Wadah untuk menyusun komponen secara berurutan. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">
        <!-- Menampilkan teks pada halaman. -->
        <TextView
            android:id="@+id/card_tag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/teal"
            android:textSize="12sp" />
        <!-- Tombol tindakan; fitur aktivitas tertentu masih dinonaktifkan. -->
        <Button
            android:id="@+id/card_action"
            style="@style/Primary"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minHeight="44dp"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>

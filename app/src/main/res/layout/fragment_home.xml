<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <!-- Wadah untuk menyusun komponen secara berurutan. -->
    <LinearLayout
        android:id="@+id/home_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <!-- Menampilkan teks pada halaman. -->
        <TextView
            android:id="@+id/greeting"
            style="@style/Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Halo, Chia ☀" />
        <!-- Menampilkan teks pada halaman. -->
        <TextView
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yuk, jaga lingkungan, mulai dari sekitar kita!"
            android:layout_marginBottom="18dp" />
        <!-- Kotak teks pencarian atau isian sesuai desain. -->
        <EditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_search"
            android:singleLine="true"
            android:inputType="text"
            android:textSize="14sp"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:hint="Cari di lingkunganmu…"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp" />
        <!-- Wadah untuk menyusun komponen secara berurutan. -->
        <LinearLayout
            android:id="@+id/shortcuts"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:orientation="horizontal"
            android:gravity="center">
            <!-- Wadah untuk menyusun komponen secara berurutan. -->
            <LinearLayout
                android:id="@+id/shortcut_community"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <!-- Menampilkan gambar atau ikon dari drawable. -->
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:background="@drawable/bg_shortcut_community"
                    android:src="@drawable/ic_people"
                    app:tint="#FFFFFF"
                    android:contentDescription="Komunitas" />
                <!-- Menampilkan teks pada halaman. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Komunitas"
                    android:textSize="11sp"
                    android:textColor="@color/teal"
                    android:paddingTop="8dp" />
            </LinearLayout>
            <!-- Wadah untuk menyusun komponen secara berurutan. -->
            <LinearLayout
                android:id="@+id/shortcut_local"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <!-- Menampilkan gambar atau ikon dari drawable. -->
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:background="@drawable/bg_shortcut_local"
                    android:src="@drawable/ic_pin"
                    app:tint="#FFFFFF"
                    android:contentDescription="Lokasi Lokal" />
                <!-- Menampilkan teks pada halaman. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Lokasi Lokal"
                    android:textSize="11sp"
                    android:textColor="@color/teal"
                    android:paddingTop="8dp" />
            </LinearLayout>
            <!-- Wadah untuk menyusun komponen secara berurutan. -->
            <LinearLayout
                android:id="@+id/shortcut_events"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <!-- Menampilkan gambar atau ikon dari drawable. -->
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:background="@drawable/bg_shortcut_events"
                    android:src="@drawable/ic_event"
                    app:tint="#FFFFFF"
                    android:contentDescription="Event" />
                <!-- Menampilkan teks pada halaman. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Event"
                    android:textSize="11sp"
                    android:textColor="@color/teal"
                    android:paddingTop="8dp" />
            </LinearLayout>
            <!-- Wadah untuk menyusun komponen secara berurutan. -->
            <LinearLayout
                android:id="@+id/shortcut_help"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <!-- Menampilkan gambar atau ikon dari drawable. -->
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:background="@drawable/bg_shortcut_help"
                    android:src="@drawable/ic_heart"
                    app:tint="#FFFFFF"
                    android:contentDescription="Mutual Help" />
                <!-- Menampilkan teks pada halaman. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Mutual Help"
                    android:textSize="11sp"
                    android:textColor="@color/teal"
                    android:paddingTop="8dp" />
            </LinearLayout>
        </LinearLayout>
        <!-- Wadah untuk menyusun komponen secara berurutan. -->
        <LinearLayout
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@drawable/bg_primary"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_marginVertical="16dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Bersama jaga lingkungan kita, lihat komunitas">
            <!-- Wadah untuk menyusun komponen secara berurutan. -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">
                <!-- Menampilkan teks pada halaman. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bersama Jaga Lingkungan Kita"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="20sp" />
                <!-- Menampilkan teks pada halaman. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mulai dari hal kecil. Lihat sekarang →"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
            <!-- Menampilkan gambar atau ikon dari drawable. -->
            <ImageView
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:src="@drawable/community_hero"
                android:scaleType="centerCrop"
                android:contentDescription="Bersama warga" />
        </LinearLayout>
        <!-- Wadah untuk menyusun komponen secara berurutan. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <!-- Menampilkan teks pada halaman. -->
            <TextView
                style="@style/Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Event Terdekat"
                android:textSize="16sp" />
            <!-- Menampilkan teks pada halaman. -->
            <TextView
                android:id="@+id/see_events"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="Lihat semua ›"
                android:textColor="@color/teal"
                android:textSize="12sp"
                android:paddingStart="12dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
        <!-- Wadah untuk menyusun komponen secara berurutan. -->
        <LinearLayout
            android:id="@+id/home_events"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginBottom="12dp">
                <!-- Menampilkan gambar atau ikon dari drawable. -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="138dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/community_hero"
                    android:contentDescription="Ilustrasi kegiatan komunitas" />
                <!-- Menampilkan teks pada halaman. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="Aksi Bersih Lingkungan" />
                <!-- Menampilkan teks pada halaman. -->
                <TextView
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="12sp"
                    android:text="31 Oktober • Taman Kota Harapan" />
                <!-- Menampilkan teks pada halaman. -->
                <TextView
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Kegiatan bersama warga RW 04." />
                <!-- Wadah untuk menyusun komponen secara berurutan. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">
                    <!-- Menampilkan teks pada halaman. -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/teal"
                        android:textSize="12sp"
                        android:text="Lingkungan • Gratis" />
                    <!-- Tombol tindakan; fitur aktivitas tertentu masih dinonaktifkan. -->
                    <Button
                        style="@style/Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:minHeight="44dp"
                        android:textSize="12sp"
                        android:text="Ikuti Event"
                        android:enabled="false" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginBottom="12dp">
                <!-- Menampilkan gambar atau ikon dari drawable. -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="138dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/event_garden"
                    android:contentDescription="Ilustrasi kegiatan komunitas" />
                <!-- Menampilkan teks pada halaman. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="Workshop Urban Farming" />
                <!-- Menampilkan teks pada halaman. -->
                <TextView
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="12sp"
                    android:text="1 November • Balai RW 04" />
                <!-- Menampilkan teks pada halaman. -->
                <TextView
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Kegiatan bersama warga RW 04." />
                <!-- Wadah untuk menyusun komponen secara berurutan. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">
                    <!-- Menampilkan teks pada halaman. -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/teal"
                        android:textSize="12sp"
                        android:text="Edukasi • Rp25.000" />
                    <!-- Tombol tindakan; fitur aktivitas tertentu masih dinonaktifkan. -->
                    <Button
                        style="@style/Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:minHeight="44dp"
                        android:textSize="12sp"
                        android:text="Ikuti Event"
                        android:enabled="false" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

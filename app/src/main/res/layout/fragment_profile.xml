<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">
    <!-- Menampilkan teks pada halaman. -->
    <TextView
        android:id="@+id/simple_heading"
        style="@style/Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    <!-- Menampilkan teks pada halaman. -->
    <TextView
        android:id="@+id/simple_body"
        style="@style/Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="16dp" />
    <!-- Tombol tindakan; fitur aktivitas tertentu masih dinonaktifkan. -->
    <Button
        android:id="@+id/simple_action"
        style="@style/Primary"
        android:layout_width="match_parent"
        android:layout_height="48dp" />
    <!-- Tombol tindakan; fitur aktivitas tertentu masih dinonaktifkan. -->
    <Button
        android:id="@+id/btn_logout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="Logout"
        android:textAllCaps="false"
        android:textColor="@android:color/white" />
    <!-- Daftar yang diisi melalui adapter sesuai modul 7. -->
    <ListView
        android:id="@+id/simple_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp" />
</LinearLayout>

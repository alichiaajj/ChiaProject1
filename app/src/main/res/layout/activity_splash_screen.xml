<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">
    <!-- Resource Space untuk tampilan aplikasi. -->
    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="0.25" />
    <!-- Menampilkan gambar atau ikon dari drawable. -->
    <ImageView
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:src="@drawable/civic_logo"
        android:contentDescription="Logo Civic Pulse" />
    <!-- Menampilkan teks pada halaman. -->
    <TextView
        style="@style/Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Civic Pulse"
        android:textColor="@color/teal"
        android:textSize="36sp" />
    <!-- Menampilkan teks pada halaman. -->
    <TextView
        style="@style/Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/slogan"
        android:textColor="@color/teal"
        android:gravity="center" />
    <!-- Menampilkan gambar atau ikon dari drawable. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:contentDescription="Warga merawat lingkungan hijau"
        android:scaleType="centerCrop"
        android:src="@drawable/community_hero" />
    <!-- Tombol tindakan; fitur aktivitas tertentu masih dinonaktifkan. -->
    <Button
        android:id="@+id/start"
        style="@style/Primary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:text="Mulai" />
</LinearLayout>

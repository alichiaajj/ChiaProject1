<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="20dp">
    <!-- Kotak teks pencarian atau isian sesuai desain. -->
    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_search"
        android:singleLine="true"
        android:inputType="text"
        android:textSize="14sp"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="10dp"
        android:hint="Cari di lingkunganmu…"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="12dp" />
    <!-- Wadah kategori yang dapat digulir ke samping. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:scrollbars="none">
        <!-- Wadah untuk menyusun komponen secara berurutan. -->
        <LinearLayout
            android:id="@+id/filters"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:textColor="@color/teal"
                android:text="Semua" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:textColor="@color/teal"
                android:text="Membutuhkan" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:textColor="@color/teal"
                android:text="Menawarkan" />
        </LinearLayout>
    </HorizontalScrollView>
    <!-- Tombol tindakan; fitur aktivitas tertentu masih dinonaktifkan. -->
    <Button
        android:id="@+id/add_help"
        style="@style/Primary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="＋ Minta Bantuan"
        android:layout_marginBottom="12dp" />
    <!-- Menampilkan teks pada halaman. -->
    <TextView
        android:id="@+id/result_count"
        style="@style/Body"
        android:layout_width="match_parent"
        android:layout_height="32dp" />
    <!-- Menampilkan teks pada halaman. -->
    <TextView
        android:id="@+id/empty"
        style="@style/Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:text="Belum ada hasil. Coba kata kunci atau kategori lain."
        android:visibility="gone" />
    <!-- Daftar yang diisi melalui adapter sesuai modul 7. -->
    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="12dp"
        android:clipToPadding="false"
        android:paddingBottom="18dp" />
</LinearLayout>
